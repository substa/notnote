# Absolute path to the file-based Markdown graph on the Docker host.
NOTNOTE_GRAPH_PATH=/srv/notnote/graph

# UID/GID that own the graph directory on the host (`id -u` and `id -g`).
NOTNOTE_UID=1000
NOTNOTE_GID=1000

# Keep the service on loopback unless binding it to a controlled private interface.
NOTNOTE_BIND_ADDRESS=127.0.0.1
NOTNOTE_PORT=4176

# Use `runtime` without Git (default), or `runtime-git` for optional page history.
NOTNOTE_DOCKER_TARGET=runtime
